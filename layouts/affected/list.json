{{ $incidents := where .Pages "Params.section" "issue" }}{{ $active := where (where $incidents "Params.resolved" "=" false) "Params.informational" "!=" true }}{{ $isNotice := where $active "Params.severity" "=" "notice" }}{{ $isDisrupted := where $active "Params.severity" "=" "disrupted" }}{{ $isDown := where $active "Params.severity" "=" "down" }}{{ $componentExperiments := partial "experiments/for-affected.html" (dict "page" . "affected" (slice .Title)) }}{
  "is": "system",
  "title": {{ .Title | default "" | jsonify }},
  "permalink": {{ .Permalink | default "" | jsonify }},
  "status": {{ if $isDown }}"down",{{ else }}{{ if $isDisrupted }}"disrupted",{{ else }}{{ if $isNotice }}"notice",{{ else }}"ok",{{ end }}{{ end }}{{ end }}
  "experimentStatus": {{ $componentExperiments.status | default "" | jsonify }},
  "runningExperimentCount": {{ len $componentExperiments.running }},
  "startingSoonExperimentCount": {{ len $componentExperiments.startingSoon }},
  "experimentsUrl": {{ $componentExperiments.url | default "" | jsonify }},
  "experiments": [{{ range $i, $e := $componentExperiments.visible }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}],
  "pages": [{{ range $i, $e := .Pages }}{{ if $i }},{{ end }}{{ if eq .Section "issues" }}
      {
        "is": "issue",
        "kind": {{ .Params.recordKind | default (.Params.kind | default (cond .Params.informational "announcement" "incident")) | default "" | jsonify }},
        "title": {{ .Title | default "" | jsonify }},
        "createdAt": {{ printf "%v" .Date | jsonify }},
        "lastMod": {{ printf "%v" .Lastmod | jsonify }},
        "permalink": {{ .Permalink | default "" | jsonify }},
        "severity": {{ .Params.severity | default "" | jsonify }},
        "statusImpact": {{ .Params.severity | default "none" | default "" | jsonify }},
        "resolved": {{ if .Params.resolved }}true{{ else }}false{{ end }},
        "informational": {{ if .Params.informational }}true{{ else }}false{{ end }},
        "pin": {{ if .Params.pin }}true{{ else }}false{{ end }},
        "resolvedAt": {{ .Params.resolvedWhen | default "" | jsonify }},
        "affected": [{{ range $i, $e := .Params.Affected }}{{ if $i }}, {{ end }}{{ . | default "" | jsonify }}{{ end }}],
        "filename": {{ .File.LogicalName | default "" | jsonify }}
      }
    {{ else if partial "records/is-section.html" .Section }}
      {{ partial "records/json.html" (dict "page" . "includeBody" false) }}
    {{ else }}
      {
        "is": "page",
        "title": {{ .Title | default "" | jsonify }},
        "createdAt": {{ printf "%v" .Date | jsonify }},
        "lastMod": {{ printf "%v" .Lastmod | jsonify }},
        "permalink": {{ .Permalink | default "" | jsonify }},
        "filename": {{ .File.LogicalName | default "" | jsonify }},
        "summary": {{ jsonify .Summary }}
      }
    {{ end }}{{ end }}
  ]
}
