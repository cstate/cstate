{{- if partial "records/is-section.html" .Section -}}
{{ partial "records/json.html" (dict "page" . "includeBody" true) }}
{{- else -}}
{
  "is": "page",
  "title": "{{ .Title }}",
  "createdAt": "{{ .Date }}",
  "filename": "{{ .File.LogicalName }}",
  "permalink": "{{ .Permalink }}",
  "body": {{ jsonify .Content }}
}
{{- end -}}
