{{ $incidents := where .Site.RegularPages "Params.section" "issue" }}{{ $active := where (where $incidents "Params.resolved" "=" false) "Params.informational" "!=" true }}{{ $isNotice := where $active "Params.severity" "=" "notice" }}{{ $isDisrupted := where $active "Params.severity" "=" "disrupted" }}{{ $isDown := where $active "Params.severity" "=" "down" }}{{ $recordSections := partial "records/sections.html" . }}{{ $records := sort (where .Site.RegularPages "Section" "in" $recordSections) "Date" "desc" }}{{ $activeRecords := partial "records/active.html" . }}{{ $activeRecords = where $activeRecords "Section" "!=" "experiments" }}{
  "is": "index",
  "cStateVersion": "7.0.0-r1",
  "apiVersion": "2.1",
  "title": {{ .Site.Title | default "" | jsonify }},
  "languageCodeHTML": {{ .Site.Language.Locale | default "" | jsonify }},
  "languageCode": {{ T "languageCode" | default "" | jsonify }},
  "baseURL": {{ .Site.BaseURL | default "" | jsonify }},
  "description": {{ .Site.Params.Description | default "" | jsonify }},
  "summaryStatus": {{ if $isDown }}"down",{{ else }}{{ if $isDisrupted }}"disrupted",{{ else }}{{ if $isNotice }}"notice",{{ else }}"ok",{{ end }}{{ end }}{{ end }}
  "categories": [{{ range $i, $e := .Site.Params.categories }}{{ if $i }},{{ end }}{{ $categorySystems := where $.Site.Params.systems "category" "=" .name }}{{ $categoryAffected := slice .name }}{{ range $categorySystems }}{{ $categoryAffected = $categoryAffected | append .name }}{{ end }}{{ $categoryExperiments := partial "experiments/for-affected.html" (dict "page" $ "affected" $categoryAffected) }}
      {
        "name": {{ .name | default "" | jsonify }},{{ if .description }}
        "description": {{ .description | default "" | jsonify }},{{ end }}
        "hideTitle": {{ if .untitled }}true{{ else }}false{{ end }},
        "closedByDefault": {{ if .closed }}true{{ else }}false{{ end }},
        "experimentStatus": {{ $categoryExperiments.status | default "" | jsonify }},
        "runningExperimentCount": {{ len $categoryExperiments.running }},
        "startingSoonExperimentCount": {{ len $categoryExperiments.startingSoon }},
        "experimentsUrl": {{ $categoryExperiments.url | default "" | jsonify }}
      }
    {{ end }}
  ],
  {{ $informationals := where $incidents "Params.informational" "=" true }}{{ $pinnedIssues := where $informationals "Params.pin" "=" true }}
  {{ if not $pinnedIssues }}
  "pinnedIssues": []{{ else }}
  "pinnedIssues": [{{ range $i, $e := $pinnedIssues }}{{ if $i }},{{ end }}
      {
        "is": "issue",
        "kind": {{ .Params.recordKind | default (.Params.kind | default (cond .Params.informational "announcement" "incident")) | default "" | jsonify }},
        "title": {{ .Title | default "" | jsonify }},
        "createdAt": {{ .Date | jsonify }},
        "lastMod": {{ .Lastmod | jsonify }},
        "permalink": {{ .Permalink | default "" | jsonify }},
        "severity": {{ .Params.severity | default "" | jsonify }},
        "statusImpact": {{ .Params.severity | default "none" | default "" | jsonify }},
        "informational": {{ if .Params.informational }}true{{ else }}false{{ end }},
        "pin": {{ if .Params.pin }}true{{ else }}false{{ end }},
        "affected": [{{ range $i, $e := .Params.Affected }}{{ if $i }}, {{ end }}{{ . | default "" | jsonify }}{{ end }}],
        "filename": {{ .File.LogicalName | default "" | jsonify }}
      }{{ end }}
	  ]{{ end }},
	  "records": [{{ range $i, $e := $records }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}],
	  "systems": [
    {{ range $i, $e := .Site.Params.systems }}{{ if $i }},{{ end }}
      {
        "name": {{ .name | default "" | jsonify }},{{ if .description }}
        "description": {{ .description | default "" | jsonify }},{{ end }}
        "category": {{ .category | default "" | jsonify }},
	        {{ $activeComponentIssues := where $active "Params.affected" "intersect" (slice .name) }}{{ $thisIsNotice := where $activeComponentIssues "Params.severity" "=" "notice" }}{{ $thisIsDisrupted := where $activeComponentIssues "Params.severity" "=" "disrupted" }}{{ $thisIsDown := where $activeComponentIssues "Params.severity" "=" "down" }}{{ $activeComponentRecords := where $activeRecords "Params.affected" "intersect" (slice .name) }}{{ $componentExperiments := partial "experiments/for-affected.html" (dict "page" $ "affected" (slice .name)) }}
	        "status": {{ if $thisIsDown }}"down"{{ else }}{{ if $thisIsDisrupted }}"disrupted"{{ else }}{{ if $thisIsNotice }}"notice"{{ else }}"ok"{{ end }}{{ end }}{{ end }},
        {{ if not $activeComponentIssues }}
        "unresolvedIssues": []
        {{ else }}
        "unresolvedIssues": [{{ range $i, $e := $activeComponentIssues }}{{ if $i }},{{ end }}
            {
              "is": "issue",
              "kind": {{ .Params.recordKind | default (.Params.kind | default (cond .Params.informational "announcement" "incident")) | default "" | jsonify }},
              "title": {{ .Title | default "" | jsonify }},
              "createdAt": {{ .Date | jsonify }},
              "lastMod": {{ .Lastmod | jsonify }},
              "permalink": {{ .Permalink | default "" | jsonify }},
              "severity": {{ .Params.severity | default "" | jsonify }},
              "statusImpact": {{ .Params.severity | default "none" | default "" | jsonify }},
              "resolved": {{ if .Params.resolved }}true{{ else }}false{{ end }},
              "informational": {{ if .Params.informational }}true{{ else }}false{{ end }},
              "pin": {{ if .Params.pin }}true{{ else }}false{{ end }},
              "resolvedAt": {{ partial "api/timestamp.html" .Params.resolvedWhen | jsonify }},
              "affected": [{{ range $i, $e := .Params.Affected }}{{ if $i }}, {{ end }}{{ . | default "" | jsonify }}{{ end }}],
              "filename": {{ .File.LogicalName | default "" | jsonify }}
            }
          {{ end }}
	        ]{{ end }},
	        "activeRecords": [{{ range $i, $e := $activeComponentRecords }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}],
	        "experimentStatus": {{ $componentExperiments.status | default "" | jsonify }},
	        "runningExperimentCount": {{ len $componentExperiments.running }},
	        "startingSoonExperimentCount": {{ len $componentExperiments.startingSoon }},
	        "experimentsUrl": {{ $componentExperiments.url | default "" | jsonify }},
	        "experiments": [{{ range $i, $e := $componentExperiments.visible }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}]
	      }{{ end }}
  ],
  {{ if .Site.Params.customTabs }}
  "tabs": [{{ range $i, $e := .Site.Params.customTabs }}{{ if $i }},{{ end }}
      {
        "name": {{ .name | default "" | jsonify }},
        "link": {{ .link | default "" | jsonify }}
      }
    {{ end }}
  ],{{ end }}

  "buildDate": {{ now.Format "2006-01-02" | default "" | jsonify }},
  "buildTime": {{ now.Format "15:04" | default "" | jsonify }},
  "buildTimezone": {{ now.Format "MST" | default "" | jsonify }},
  "colorBrand": {{ .Site.Params.Brand | default "" | jsonify }},
  "colorOk": {{ .Site.Params.Ok | default "" | jsonify }},
  "colorDisrupted": {{ .Site.Params.Disrupted | default "" | jsonify }},
  "colorDown": {{ .Site.Params.Down | default "" | jsonify }},
  "colorNotice": {{ .Site.Params.Notice | default "" | jsonify }},
  "alwaysKeepBrandColor": {{ printf "%v" .Site.Params.alwaysKeepBrandColor | jsonify }},
  "logo": {{ .Site.Params.logo | absURL | default "" | jsonify }},
  "googleAnalytics": {{ .Site.Params.googleAnalytics | default "" | jsonify }}
}
