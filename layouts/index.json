{{ $incidents := where .Site.RegularPages "Params.section" "issue" }}{{ $active := where $incidents "Params.resolved" "=" false }}{{ $isNotice := where $active "Params.severity" "=" "notice" }}{{ $isDisrupted := where $active "Params.severity" "=" "disrupted" }}{{ $isDown := where $active "Params.severity" "=" "down" }}{{ $recordSections := partial "records/sections.html" . }}{{ $records := sort (where .Site.RegularPages "Section" "in" $recordSections) "Date" "desc" }}{{ $activeRecordsByState := where $records "Params.state" "=" "active" }}{{ $activeRecordsBySeverity := where $records "Params.severity" "=" "ongoing" }}{{ $activeRecords := union $activeRecordsByState $activeRecordsBySeverity }}{{ $activeRecords = where $activeRecords "Section" "!=" "experiments" }}{
  "is": "index",
  "cStateVersion": "7.0",
  "apiVersion": "2.1",
  "title": "{{ .Site.Title }}",
  "languageCodeHTML": "{{ .Site.Language.Locale }}",
  "languageCode": "{{ T "languageCode" }}",
  "baseURL": "{{ .Site.BaseURL }}",
  "description": "{{ .Site.Params.Description }}",
  "summaryStatus": {{ if $isDown }}"down",{{ else }}{{ if $isDisrupted }}"disrupted",{{ else }}{{ if $isNotice }}"notice",{{ else }}"ok",{{ end }}{{ end }}{{ end }}
  "categories": [{{ range $i, $e := .Site.Params.categories }}{{ if $i }},{{ end }}{{ $categorySystems := where $.Site.Params.systems "category" "=" .name }}{{ $categoryAffected := slice .name }}{{ range $categorySystems }}{{ $categoryAffected = $categoryAffected | append .name }}{{ end }}{{ $categoryExperiments := partial "experiments/for-affected.html" (dict "page" $ "affected" $categoryAffected) }}
      {
        "name": "{{ .name }}",{{ if .description }}
        "description": "{{ .description }}",{{ end }}
        "hideTitle": {{ if .untitled }}true{{ else }}false{{ end }},
        "closedByDefault": {{ if .closed }}true{{ else }}false{{ end }},
        "experimentStatus": "{{ $categoryExperiments.status }}",
        "runningExperimentCount": {{ len $categoryExperiments.running }},
        "startingSoonExperimentCount": {{ len $categoryExperiments.startingSoon }},
        "experimentsUrl": "{{ $categoryExperiments.href }}"
      }
    {{ end }}
  ],
  {{ $informationals := where $incidents "Params.informational" "=" true }}{{ $pinnedIssues := where $informationals "Params.pin" "=" true }}
  {{ if not $pinnedIssues }}
  "pinnedIssues": []{{ else }}
  "pinnedIssues": [{{ range $i, $e := $pinnedIssues }}{{ if $i }},{{ end }}
      {
        "is": "issue",
        "kind": "{{ .Params.recordKind | default (.Params.kind | default (cond .Params.informational "announcement" "incident")) }}",
        "title": "{{ .Title }}",
        "createdAt": "{{ .Date }}",
        "lastMod": "{{ .Lastmod }}",
        "permalink": "{{ .Permalink }}",
        "severity": "{{ .Params.severity }}",
        "statusImpact": "{{ .Params.severity | default "none" }}",
        "informational": {{ if .Params.informational }}true{{ else }}false{{ end }},
        "pin": {{ if .Params.pin }}true{{ else }}false{{ end }},
        "affected": [{{ range $i, $e := .Params.Affected }}{{ if $i }}, {{ end }}"{{ . }}"{{ end }}],
        "filename": "{{ .File.LogicalName }}"
      }{{ end }}
	  ]{{ end }},
	  "records": [{{ range $i, $e := $records }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}],
	  "systems": [
    {{ range $i, $e := .Site.Params.systems }}{{ if $i }},{{ end }}
      {
        "name": "{{ .name }}",{{ if .description }}
        "description": "{{ .description }}",{{ end }}
        "category": "{{ .category }}",
	        {{ $activeComponentIssues := where $active "Params.affected" "intersect" (slice .name) }}{{ $thisIsNotice := where $activeComponentIssues "Params.severity" "=" "notice" }}{{ $thisIsDisrupted := where $activeComponentIssues "Params.severity" "=" "disrupted" }}{{ $thisIsDown := where $activeComponentIssues "Params.severity" "=" "down" }}{{ $activeComponentRecords := where $activeRecords "Params.affected" "intersect" (slice .name) }}{{ $componentExperiments := partial "experiments/for-affected.html" (dict "page" $ "affected" (slice .name)) }}
	        "status": {{ if $thisIsDown }}"down"{{ else }}{{ if $thisIsDisrupted }}"disrupted"{{ else }}{{ if $thisIsNotice }}"notice"{{ else }}"ok"{{ end }}{{ end }}{{ end }},
        {{ if not $activeComponentIssues }}
        "unresolvedIssues": []
        {{ else }}
        "unresolvedIssues": [{{ range $i, $e := $activeComponentIssues }}{{ if $i }},{{ end }}
            {
              "is": "issue",
              "kind": "{{ .Params.recordKind | default (.Params.kind | default (cond .Params.informational "announcement" "incident")) }}",
              "title": "{{ .Title }}",
              "createdAt": "{{ .Date }}",
              "lastMod": "{{ .Lastmod }}",
              "permalink": "{{ .Permalink }}",
              "severity": "{{ .Params.severity }}",
              "statusImpact": "{{ .Params.severity | default "none" }}",
              "resolved": {{ if .Params.resolved }}true{{ else }}false{{ end }},
              "informational": {{ if .Params.informational }}true{{ else }}false{{ end }},
              "pin": {{ if .Params.pin }}true{{ else }}false{{ end }},
              "resolvedAt": "{{ .Params.resolvedWhen }}",
              "affected": [{{ range $i, $e := .Params.Affected }}{{ if $i }}, {{ end }}"{{ . }}"{{ end }}],
              "filename": "{{ .File.LogicalName }}"
            }
          {{ end }}
	        ]{{ end }},
	        "activeRecords": [{{ range $i, $e := $activeComponentRecords }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}],
	        "experimentStatus": "{{ $componentExperiments.status }}",
	        "runningExperimentCount": {{ len $componentExperiments.running }},
	        "startingSoonExperimentCount": {{ len $componentExperiments.startingSoon }},
	        "experimentsUrl": "{{ $componentExperiments.href }}",
	        "experiments": [{{ range $i, $e := $componentExperiments.visible }}{{ if $i }},{{ end }}{{ partial "records/json.html" (dict "page" . "includeBody" false) }}{{ end }}]
	      }{{ end }}
  ],
  {{ if .Site.Params.customTabs }}
  "tabs": [{{ range $i, $e := .Site.Params.customTabs }}{{ if $i }},{{ end }}
      {
        "name": "{{ .name }}",
        "link": "{{ .description }}"
      }
    {{ end }}
  ],{{ end }}

  "buildDate": "{{ now.Format "2006-01-02" }}",
  "buildTime": "{{ now.Format "15:04" }}",
  "buildTimezone": "{{ now.Format "MST" }}",
  "colorBrand": "{{ .Site.Params.Brand }}",
  "colorOk": "{{ .Site.Params.Ok }}",
  "colorDisrupted": "{{ .Site.Params.Disrupted }}",
  "colorDown": "{{ .Site.Params.Down }}",
  "colorNotice": "{{ .Site.Params.Notice }}",
  "alwaysKeepBrandColor": "{{ .Site.Params.alwaysKeepBrandColor }}",
  "logo": "{{ .Site.Params.logo | absURL }}",
  "googleAnalytics": "{{ .Site.Params.googleAnalytics }}"
}
